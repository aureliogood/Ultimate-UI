{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "cases": [
      {
        "when": "slim",
        "model": {
          "type": "minecraft:special",
          "base": "minecraft:uui/player/slim/middle",
          "model": {
            "type": "minecraft:head",
            "kind": "player"
          }
        }
      }
    ],
    "fallback": {
      "type": "minecraft:special",
      "base": "minecraft:uui/player/middle",
      "model": {
        "type": "minecraft:head",
        "kind": "player"
      }
    },
    "tints": [
      {
        "type": "minecraft:dye",
        "default": [
          1,
          1,
          1
        ]
      }
    ]
  }
}
